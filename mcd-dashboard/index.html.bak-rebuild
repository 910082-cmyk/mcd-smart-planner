<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>麦麦智配 · 热量与消费决策助手</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg%20viewBox%3D%220%200%2024%2024%22%20width%3D%2232%22%20height%3D%2232%22%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%3E%3Crect%20width%3D%2224%22%20height%3D%2224%22%20rx%3D%225.5%22%20fill%3D%22%23DA291C%22/%3E%3Cpath%20d%3D%22M17.243%203.006c2.066%200%203.742%208.714%203.742%2019.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127%200-4.007%202.81-5.248%207.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031%201.516%200%2010.888%200%2022.476h3.014c0-10.763%201.658-19.47%203.724-19.47%202.066%200%203.741%208.05%203.741%2017.98h2.997c0-9.93%201.684-17.98%203.75-17.98Z%22%20fill%3D%22%23FFC72C%22%20transform%3D%22translate%2812%2C12%29%20scale%280.82%29%20translate%28-12%2C-12%29%22/%3E%3C/svg%3E">
<style>
:root{
  --mc-yellow:#FFC72C; --mc-red:#DA291C; --mc-yellow-d:#F0A800; --mc-red-d:#B01F16;
  --ink:#2E1B0D; --ink2:#6B5340; --ink3:#A08D7A;
  --bg:#FFFAF3; --card:#fff; --line:#F5E9D8; --line2:#EEDFC8;
  --ok:#0B7A4B; --ok-bg:#E3F6EC; --warn:#B25A00; --warn-bg:#FFF4E3; --err:#C6231A; --err-bg:#FDECEA;
  --r:18px; --sh:0 2px 4px rgba(58,32,16,.04),0 12px 30px rgba(58,32,16,.07);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  background:var(--bg);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.wrap{max-width:1280px;margin:0 auto;padding:0 20px 90px}

/* ================= 品牌区 ================= */
#hero{position:relative;height:290px;background:var(--mc-red);overflow:hidden;box-shadow:0 6px 26px rgba(218,41,28,.3)}
#gl{position:absolute;inset:0;width:100%;height:100%;display:block}
.hero-in{position:absolute;inset:0;z-index:2;pointer-events:none;max-width:1280px;margin:0 auto;
  padding:30px 20px;display:flex;flex-direction:column;justify-content:center}
.brand{display:flex;align-items:center;gap:13px;margin-bottom:15px}
.brand img{width:44px;height:44px;flex-shrink:0;display:block}
.brand-tx h1{font-size:30px;font-weight:800;color:#fff;letter-spacing:-.8px;line-height:1.1;text-shadow:0 2px 12px rgba(0,0,0,.28)}
.brand-tx p{font-size:13.5px;color:#FFD98A;margin-top:3px}
.hero-sub{font-size:14px;color:#FFE3B0;margin:0 0 19px 57px;max-width:560px;line-height:1.65}
.hero-stats{display:flex;gap:30px;margin-left:57px;flex-wrap:wrap}
.hstv{font-size:25px;font-weight:800;color:#fff;line-height:1}
.hstl{font-size:11.5px;color:#FFC9A8;margin-top:4px}
.hero-tag{position:absolute;left:20px;bottom:14px;z-index:3;display:flex;gap:8px;flex-wrap:wrap}
.ht{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.32);padding:4px 11px;border-radius:999px;font-size:11px;color:#fff}
/* WebGL 不可用时的静态降级 */
.hero-fb{position:absolute;right:70px;top:50%;transform:translateY(-50%);z-index:1;opacity:.95}
.hero-fb img{width:150px;height:150px;display:block}

/* ================= 导航 ================= */
nav{display:flex;gap:4px;background:#fff;border-radius:var(--r);padding:6px;box-shadow:var(--sh);
  margin:-16px 0 22px;position:relative;z-index:6;overflow-x:auto}
nav button{flex:1;min-width:max-content;background:none;border:0;padding:12px 13px;border-radius:13px;
  font-family:inherit;font-size:13.5px;color:var(--ink2);cursor:pointer;font-weight:600;transition:.16s;white-space:nowrap}
nav button:hover{background:var(--bg)}
nav button.on{background:var(--mc-red);color:#fff;box-shadow:0 4px 14px rgba(218,41,28,.32)}
.tab{display:none;animation:fade .26s ease}
.tab.on{display:block}
@keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.card{background:var(--card);border-radius:var(--r);padding:24px;box-shadow:var(--sh);margin-bottom:18px}
.ct{font-size:18px;font-weight:800;margin-bottom:4px;display:flex;align-items:center;gap:9px}
.ct::before{content:"";width:4.5px;height:19px;background:var(--mc-yellow);border-radius:2px;flex-shrink:0}
.cd{font-size:12.5px;color:var(--ink3);margin-bottom:18px;padding-left:14px}

/* ================= 3D 舞台（含 2D 降级） ================= */
.stage{background:linear-gradient(170deg,#FFFCF5 0%,#FFF4DF 100%);border:1.5px solid var(--line);
  border-radius:var(--r);overflow:hidden;margin-bottom:16px;position:relative}
#menu3d{width:100%;height:400px;display:block}
.stage-hint{position:absolute;left:16px;top:14px;font-size:11.5px;color:var(--ink3);
  background:rgba(255,255,255,.85);padding:4px 10px;border-radius:999px;border:1px solid var(--line);pointer-events:none;z-index:3}
.stage-cat{position:absolute;right:16px;top:14px;font-size:11.5px;font-weight:700;color:var(--mc-red-d);
  background:rgba(255,255,255,.88);padding:4px 11px;border-radius:999px;border:1px solid #F7E2A8;pointer-events:none;z-index:3}
/* 2D 降级视图：大图 + CSS 动画 */
.fb2d{display:none;height:400px;align-items:center;justify-content:center;position:relative}
.fb2d img{width:250px;height:250px;object-fit:contain;animation:fbFloat 3.2s ease-in-out infinite;
  filter:drop-shadow(0 18px 28px rgba(138,91,24,.28))}
.fb2d::after{content:"";position:absolute;bottom:52px;left:50%;transform:translateX(-50%);
  width:190px;height:22px;border-radius:50%;background:rgba(138,91,24,.14);animation:fbShadow 3.2s ease-in-out infinite}
@keyframes fbFloat{0%,100%{transform:translateY(0) rotate(-1.5deg)}50%{transform:translateY(-16px) rotate(1.5deg)}}
@keyframes fbShadow{0%,100%{width:190px;opacity:.16}50%{width:150px;opacity:.09}}

/* 聚焦面板 */
.focus{display:flex;gap:20px;padding:20px 24px;border-top:1.5px solid var(--line);background:#fff;align-items:center;flex-wrap:wrap}
.focus-img{width:120px;height:120px;border-radius:14px;background:#F7F1E7;flex-shrink:0;overflow:hidden;border:1.5px solid var(--line);position:relative}
.focus-img img{width:100%;height:100%;object-fit:cover}
.focus-img.off::after{content:'暂无图片';position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--ink3)}
.focus-b{flex:1;min-width:220px}
.focus-n{font-size:19px;font-weight:800;margin-bottom:9px;line-height:1.3}
.focus-p{display:flex;align-items:baseline;gap:10px;margin-bottom:11px;flex-wrap:wrap}
.focus-pv{font-size:31px;font-weight:800;color:var(--mc-red);line-height:1}
.focus-po{font-size:13px;color:var(--ink3);text-decoration:line-through}
.focus-sv{font-size:12px;font-weight:800;color:#fff;background:var(--mc-red);padding:2px 8px;border-radius:6px}
.focus-m{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
.fm{display:inline-flex;align-items:center;gap:5px;font-size:12.5px;font-weight:700;color:var(--ink2);background:var(--bg);padding:5px 10px;border-radius:8px;border:1px solid var(--line)}
.fm.k{color:var(--mc-red);border-color:#FBD6D2;background:var(--err-bg)}
.focus-t{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:14px}
.fg{font-size:11px;background:var(--bg);color:var(--ink2);padding:4px 9px;border-radius:6px;border:1px solid var(--line)}
.fg.hot{background:var(--err-bg);color:var(--err);border-color:#FBD6D2;font-weight:700}
.fg.gold{background:#FFF6DD;color:#8A5B18;border-color:#F7E2A8;font-weight:700}
.nocal{color:var(--ink3);font-size:11px;font-style:italic;font-weight:400}

/* 缩略图条 */
.strip{background:#fff;border:1.5px solid var(--line);border-radius:var(--r);padding:14px;margin-bottom:16px}
.strip-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:11px;gap:10px;flex-wrap:wrap}
.strip-t{font-size:12.5px;color:var(--ink2);font-weight:700}
.strip-c{font-size:11.5px;color:var(--ink3)}
.strip-l{display:flex;gap:9px;overflow-x:auto;padding-bottom:6px;scroll-behavior:smooth}
.strip-l::-webkit-scrollbar{height:6px}
.strip-l::-webkit-scrollbar-thumb{background:var(--line2);border-radius:3px}
.tile{flex-shrink:0;width:88px;cursor:pointer;border:2px solid var(--line);border-radius:11px;overflow:hidden;
  background:#fff;transition:.18s;position:relative;padding:0;font-family:inherit}
.tile:hover{border-color:var(--mc-yellow);transform:translateY(-3px)}
.tile.on{border-color:var(--mc-red);box-shadow:0 6px 18px rgba(218,41,28,.26);transform:translateY(-3px)}
.tile img{width:100%;height:66px;object-fit:cover;display:block;background:#F7F1E7}
.tile-n{font-size:10.5px;padding:5px 4px;line-height:1.3;color:var(--ink2);font-weight:600;height:32px;overflow:hidden;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.tile.on .tile-n{color:var(--mc-red);font-weight:800}
.tile-idx{position:absolute;left:4px;top:4px;font-size:9px;font-weight:800;color:#fff;background:rgba(0,0,0,.42);border-radius:4px;padding:1px 4px}

/* 搜索与分类 */
.sbox{position:relative;margin-bottom:14px}
input[type=text],input[type=number],select{width:100%;font-family:inherit;font-size:15px;padding:14px 16px;
  border:2px solid var(--line);border-radius:13px;background:#FFFDF9;color:var(--ink);transition:.16s}
input[type=text]:focus,input[type=number]:focus,select:focus{outline:none;border-color:var(--mc-yellow);background:#fff;box-shadow:0 0 0 4px rgba(255,199,44,.16)}
.sbox input{padding-right:46px}
.sico{position:absolute;right:16px;top:50%;transform:translateY(-50%);color:var(--mc-yellow);font-size:21px;font-weight:800;pointer-events:none}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{background:#FFFDF9;border:1.5px solid var(--line);border-radius:999px;padding:8px 15px;font-size:13px;
  cursor:pointer;color:var(--ink2);transition:.16s;font-family:inherit;font-weight:600}
.chip:hover{border-color:var(--mc-yellow);background:#fff}
.chip.on{background:var(--mc-yellow);border-color:var(--mc-yellow);color:#4A3000}
.chip .n{color:var(--ink3);font-weight:500;margin-left:3px}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(228px,1fr));gap:16px}
.mi{background:#fff;border:1.5px solid var(--line);border-radius:15px;overflow:hidden;transition:.2s;display:flex;flex-direction:column}
.mi:hover{border-color:var(--mc-yellow);transform:translateY(-4px);box-shadow:0 14px 32px rgba(255,199,44,.3)}
.mimg{height:148px;background:#F7F1E7;position:relative;overflow:hidden}
.mimg img{width:100%;height:100%;object-fit:cover;transition:transform .35s}
.mi:hover .mimg img{transform:scale(1.07)}
.mflag{position:absolute;left:9px;top:9px;background:var(--mc-red);color:#fff;font-size:10.5px;font-weight:800;padding:3px 8px;border-radius:6px;z-index:2}
.moff{position:absolute;right:9px;top:9px;background:rgba(255,255,255,.94);color:var(--mc-red);font-size:11px;font-weight:800;padding:3px 8px;border-radius:6px;z-index:2}
.mbody{padding:13px;flex:1;display:flex;flex-direction:column}
.mn{font-size:14px;font-weight:700;line-height:1.35;margin-bottom:8px;min-height:38px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.mp{display:flex;align-items:baseline;gap:7px;margin-bottom:9px}
.mpv{font-size:19px;font-weight:800;color:var(--mc-red)}
.mpo{font-size:11.5px;color:var(--ink3);text-decoration:line-through}
.mkc{font-size:11.5px;font-weight:700;color:var(--ink2);background:var(--bg);padding:3px 8px;border-radius:6px;margin-bottom:9px;width:fit-content}
.madd{margin-top:auto;background:var(--mc-yellow);border:0;border-radius:9px;padding:9px;font-family:inherit;font-size:12.5px;font-weight:800;color:#4A3000;cursor:pointer;transition:.15s}
.madd:hover{background:var(--mc-yellow-d);transform:scale(1.02)}

table{width:100%;border-collapse:collapse;font-size:13.5px}
th{text-align:left;padding:11px 12px;background:var(--bg);font-weight:800;font-size:12px;color:var(--ink2);border-bottom:2px solid var(--line2);white-space:nowrap}
td{padding:12px;border-bottom:1px solid #FAF4EA;vertical-align:top}
tr:last-child td{border-bottom:0}
.tw{overflow-x:auto;-webkit-overflow-scrolling:touch}
.note{padding:14px 16px;border-radius:11px;font-size:12.5px;line-height:1.7;margin:14px 0}
.note.w{background:var(--warn-bg);border-left:4px solid var(--warn);color:#7A3E00}
.note.e{background:var(--err-bg);border-left:4px solid var(--err);color:#8C1A14}
.note.o{background:var(--ok-bg);border-left:4px solid var(--ok);color:#0A5537}
.note code,code{background:rgba(0,0,0,.05);padding:1.5px 5px;border-radius:4px;font-size:11.5px;font-family:ui-monospace,Menlo,Consolas,monospace}
.btn{background:var(--mc-yellow);border:0;border-radius:12px;padding:14px 24px;font-family:inherit;font-size:14px;font-weight:800;color:#4A3000;cursor:pointer;transition:.16s;box-shadow:0 3px 10px rgba(255,199,44,.4)}
.btn:hover{background:var(--mc-yellow-d);transform:translateY(-2px);box-shadow:0 7px 18px rgba(255,199,44,.5)}
.btn.r{background:var(--mc-red);color:#fff;box-shadow:0 3px 10px rgba(218,41,28,.32)}
.btn.r:hover{background:var(--mc-red-d);box-shadow:0 7px 18px rgba(218,41,28,.42)}
.row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.f{flex:1;min-width:148px}
.lbl{font-size:12.5px;color:var(--ink2);margin-bottom:7px;font-weight:700}

.pc{background:linear-gradient(135deg,var(--mc-yellow),#FFB612);border-radius:var(--r);padding:26px;margin-bottom:18px;
  display:flex;justify-content:space-between;align-items:center;gap:18px;flex-wrap:wrap;box-shadow:0 8px 26px rgba(255,199,44,.34)}
.pcn{font-size:13px;color:#7A4E10;margin-bottom:3px;font-weight:700}
.pcval{font-size:38px;font-weight:800;color:#3A2010;line-height:1.02}
.pcs{font-size:12.5px;color:#8A5B18;margin-top:7px}
.bar{height:8px;background:rgba(255,255,255,.55);border-radius:4px;overflow:hidden;margin-top:6px}
.barf{height:100%;border-radius:4px;transition:width .35s}
.stat{background:var(--bg);border-radius:12px;padding:14px;text-align:center}
.statv{font-size:22px;font-weight:800;color:var(--ink)}
.statl{font-size:11.5px;color:var(--ink3);margin-top:3px}
.sgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(92px,1fr));gap:10px}
.stat.mc{background:linear-gradient(135deg,var(--mc-red),var(--mc-red-d))}
.stat.mc .statv{color:#fff}.stat.mc .statl{color:#FFC9C4}
.rk{background:var(--bg);border:1.5px solid var(--line);border-radius:14px;padding:18px;margin-bottom:13px}
.rkh{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:13px;gap:12px;flex-wrap:wrap}
.rkt{font-size:15.5px;font-weight:800}
.rkp{font-size:22px;font-weight:800;color:var(--mc-red);white-space:nowrap}
.stl{font-size:11.5px;color:var(--ink3);margin-top:3px}
.badge-best{background:var(--mc-yellow);color:#4A3000;font-size:11px;font-weight:800;padding:3px 10px;border-radius:999px;margin-left:8px;vertical-align:middle}
.versus{display:flex;align-items:center;justify-content:center;gap:13px;margin:18px 0;flex-wrap:wrap}
.vs{font-size:12px;color:var(--ink3)}
.pill{background:var(--ok-bg);color:var(--ok);padding:5px 12px;border-radius:999px;font-size:12.5px;font-weight:800}
.empty{text-align:center;padding:52px 20px;color:var(--ink3)}
.emptyi{font-size:42px;margin-bottom:13px;opacity:.3}
.feat{background:#fff;border:1.5px solid var(--line);border-radius:15px;padding:18px}
.fi{width:42px;height:42px;border-radius:12px;background:var(--mc-red);display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.fi img{width:26px;height:26px}.fi svg{width:26px;height:26px;display:block}
.fic{width:42px;height:42px;border-radius:12px;background:var(--mc-red);display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.fic svg{width:26px;height:26px;display:block}
.fo{background:#FBF6EE;border:1.5px solid var(--line);border-radius:11px;padding:14px;margin-bottom:11px}
.fot{font-size:13.5px;font-weight:800;margin-bottom:7px}
.fod{font-size:12.5px;color:var(--ink2);line-height:1.75}
.foot{text-align:center;padding:32px 20px 0;color:var(--ink3);font-size:12px;line-height:1.9}

@media(max-width:640px){
  #hero{height:auto;min-height:300px}
  .hero-in{position:relative;padding:26px 18px 42px}
  .hero-sub{margin-left:0;font-size:13px}
  .hero-stats{margin-left:0;gap:20px}
  .hero-tag{position:relative;left:0;bottom:0;margin:16px 18px 0}
  .hero-fb{display:none!important}
  .brand img{width:36px;height:36px}
  .brand-tx h1{font-size:23px}
  #menu3d,.fb2d{height:300px}
  .fb2d img{width:180px;height:180px}
  .card{padding:18px}.wrap{padding:0 14px 66px}.pcval{font-size:30px}
  .grid{grid-template-columns:repeat(auto-fill,minmax(158px,1fr));gap:11px}
  .mimg{height:116px}.focus{padding:16px}
  .focus-img{width:88px;height:88px}
  .focus-n{font-size:16px}.focus-pv{font-size:25px}
}
</style>
</head>
<body>

<!-- ================= 品牌区 ================= -->
<section id="hero">
  <canvas id="gl"></canvas>
  <div class="hero-fb" id="heroFb" style="display:none"><svg viewBox="0 0 24 24" width="150" height="150" xmlns="http://www.w3.org/2000/svg" ><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFC72C"/></svg></div>
  <div class="hero-in">
    <div class="brand">
      <svg viewBox="0 0 24 24" width="44" height="44" xmlns="http://www.w3.org/2000/svg" ><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFC72C"/></svg>
      <div class="brand-tx">
        <h1>麦麦智配</h1>
        <p>热量 · 配餐 · 优惠 · 点单 一站式决策助手</p>
      </div>
    </div>
    <p class="hero-sub">全部数据来自麦当劳 MCP Server 官方接口 · 菜单顺序与门店实时售价严格同步</p>
    <div class="hero-stats">
      <div><div class="hstv" id="s1">121</div><div class="hstl">在售餐品</div></div>
      <div><div class="hstv" id="s2">61</div><div class="hstl">营养条目</div></div>
      <div><div class="hstv">5</div><div class="hstl">长沙门店</div></div>
      <div><div class="hstv">35</div><div class="hstl">MCP 工具</div></div>
    </div>
  </div>
  <div class="hero-tag">
    <span class="ht">M-CODE 2026 参赛作品</span>
    <span class="ht" id="htMode">3D 食物模型 · Three.js</span>
  </div>
</section>

<div class="wrap">
<nav>
  <button class="on" data-t="menu">菜单看板</button>
  <button data-t="search">食物查询</button>
  <button data-t="kcal">热量配餐</button>
  <button data-t="coupon">优惠最大化</button>
  <button data-t="order">点单建议</button>
  <button data-t="points">积分·领券</button>
  <button data-t="mcd">功能集成</button>
</nav>

<!-- ================= 菜单看板 ================= -->
<section class="tab on" id="menu">
  <div class="card">
    <div class="ct">菜单看板</div>
    <div class="cd">分类与排序严格遵循麦当劳现行菜单 · 门店 storeCode 3390081 长沙五一路平和堂餐厅</div>
    <div class="sbox">
      <input type="text" id="q" placeholder="搜索菜名，如「巨无霸」「鸡腿堡」「咖啡」「麦旋风」…" oninput="render()" autocomplete="off">
      <span class="sico">⌕</span>
    </div>
    <div class="chips" id="cats"></div>
  </div>

  <div class="stage">
    <canvas id="menu3d"></canvas>
    <div class="fb2d" id="fb2d"><img id="fb2dImg" src="" alt=""></div>
    <div class="stage-hint" id="stageHint">悬停或点击缩略图 · 模型将浮现并聚焦</div>
    <div class="stage-cat" id="stageCat">人气热卖</div>
    <div class="focus" id="focusPanel"></div>
  </div>

  <div class="strip">
    <div class="strip-h">
      <div class="strip-t" id="stripT">人气热卖</div>
      <div class="strip-c" id="stripC"></div>
    </div>
    <div class="strip-l" id="strip"></div>
  </div>

  <div class="card">
    <div class="row" style="justify-content:space-between;margin-bottom:16px">
      <div style="font-size:13px;color:var(--ink2)">共 <b id="cnt">0</b> 项</div>
      <select id="sort" style="width:auto;padding:9px 13px;font-size:13px" onchange="render()">
        <option value="official">官方菜单顺序</option>
        <option value="price">价格从低到高</option>
        <option value="priceDesc">价格从高到低</option>
        <option value="save">折扣力度</option>
        <option value="kcalAsc">热量从低到高</option>
        <option value="kcalDesc">热量从高到低</option>
      </select>
    </div>
    <div class="grid" id="list"></div>
  </div>
</section>

<section class="tab" id="search">
  <div class="card">
    <div class="ct">食物查询</div>
    <div class="cd">查询单个餐品的完整营养成分，以及可用的积分兑换方案</div>
    <div class="sbox">
      <input type="text" id="q2" placeholder="输入食物名称，如「巨无霸」「中薯条」「燕麦奶铁」" oninput="doSearch()" autocomplete="off">
      <span class="sico">⌕</span>
    </div>
    <div class="chips" id="q2chips"></div>
  </div>
  <div id="searchOut"></div>
</section>

<section class="tab" id="kcal">
  <div class="card">
    <div class="ct">热量配餐</div>
    <div class="cd">设定目标热量，在真实菜单中搜索组合，按总价从低到高排序</div>
    <div class="row">
      <div class="f"><div class="lbl">目标热量（千卡）</div><input type="number" id="target" value="800" min="100" max="3000" step="50"></div>
      <div class="f"><div class="lbl">容差</div><select id="tol">
        <option value="0.05">±5%（精准）</option><option value="0.1" selected>±10%（推荐）</option><option value="0.2">±20%（宽松）</option>
      </select></div>
      <div class="f"><div class="lbl">排序</div><select id="ksort">
        <option value="price">总价从低到高</option><option value="value">每千卡成本最低</option>
      </select></div>
    </div>
    <div class="row" style="margin-top:16px">
      <button class="btn r" onclick="planKcal()">生成配餐方案</button>
      <button class="chip" onclick="setT(500)">500 千卡</button>
      <button class="chip" onclick="setT(800)">800 千卡</button>
      <button class="chip" onclick="setT(1200)">1200 千卡</button>
    </div>
    <div class="note o" style="margin-top:16px"><b>数据说明：</b>热量取自 MCP <code>list-nutrition-foods</code> 全国营养库，价格取自门店 <code>query-meals</code> 实时菜单。仅展示两项数据均齐全的餐品，套餐类因营养库无对应条目已自动排除。</div>
  </div>
  <div id="kcalOut"></div>
</section>

<section class="tab" id="coupon">
  <div class="card">
    <div class="ct">优惠最大化</div>
    <div class="cd">勾选餐品，自动比价：原价 → 促销折扣 → 麦金卡到手价 → 叠加积分兑换</div>
    <div id="cartList" style="margin-bottom:18px"></div>
    <div class="row">
      <button class="btn r" onclick="calcBest()">计算最优方案</button>
      <button class="chip" onclick="addBest()">一键加入麦金卡套餐</button>
      <button class="chip" onclick="clearCart()">清空</button>
    </div>
  </div>
  <div id="couponOut"></div>
</section>

<section class="tab" id="order">
  <div class="card">
    <div class="ct">到店 / 外送点单建议</div>
    <div class="cd">先选取餐方式，再选出行方式，基于真实距离与营业状态给出建议</div>
    <div class="row">
      <div class="f"><div class="lbl">① 取餐方式</div><select id="mode">
        <option value="1">到店自取</option><option value="5">得来速车道取餐</option><option value="2">麦乐送到家</option>
      </select></div>
      <div class="f"><div class="lbl">② 出行方式</div><select id="tp">
        <option value="walk">步行</option><option value="bike">骑车</option><option value="metro">地铁</option><option value="car" selected>自驾</option>
      </select></div>
      <div class="f"><div class="lbl">③ 用餐人数</div><input type="number" id="ps" value="1" min="1" max="10"></div>
      <div class="f"><div class="lbl">④ 可接受距离（米）</div><input type="number" id="maxd" value="1500" step="100"></div>
    </div>
    <div class="row" style="margin-top:16px"><button class="btn r" onclick="advise()">生成点单建议</button></div>
  </div>
  <div id="orderOut"></div>
</section>

<section class="tab" id="points">
  <div class="pc">
    <div>
      <div class="pcn">我的可用积分</div>
      <div class="pcval" id="ap">538.2</div>
      <div class="pcs">麦享会积分 · 累计 717.5 · 已用 40 · 已过期 139.3</div>
    </div>
    <div class="sgrid" style="min-width:290px;flex:1">
      <div class="stat mc"><div class="statv" id="pCan">8</div><div class="statl">可兑商品</div></div>
      <div class="stat mc"><div class="statv" id="pBest">50</div><div class="statl">最低兑换档</div></div>
      <div class="stat mc"><div class="statv" id="pLack">1</div><div class="statl">积分不足</div></div>
    </div>
  </div>
  <div class="card">
    <div class="ct">积分兑换券</div>
    <div class="cd">已按截止时间过滤。每积分折算价值 = 券面金额 ÷ 所需积分，越高越划算</div>
    <div class="tw"><table id="ptable"></table></div>
    <div class="note w" style="margin-top:16px"><b>数据陷阱提醒：</b>MCP <code>mall-points-products</code> 返回的 <code>status</code> 字段全部标记为「上架」，但 <code>downTime</code> 显示多数已在 2026-03 / 2026-06 过期。本看板<b>以 downTime 为准</b>过滤，实测 25 条原始数据中仅 9 条有效。</div>
  </div>
  <div class="card">
    <div class="ct">我的优惠券</div>
    <div class="cd">来自 MCP <code>available-coupons</code></div>
    <div class="row" style="gap:14px;align-items:flex-start">
      <div style="flex:1"><div class="lbl">已领取 4 张</div><div id="cpC" style="display:flex;gap:7px;flex-wrap:wrap"></div></div>
      <div style="flex:1"><div class="lbl">可领取 3 张 · 零成本</div><div id="cpA" style="display:flex;gap:7px;flex-wrap:wrap"></div></div>
    </div>
    <div class="note o" style="margin-top:14px"><b>优先领券：</b>3 张可领取券价值高于任何积分兑换。领券对应 MCP <code>auto-bind-coupons</code>，该工具会真实写操作，调用前须向用户确认。</div>
  </div>
</section>

<section class="tab" id="mcd">
  <div class="card"><div class="ct">麦当劳核心功能集成</div>
    <div class="cd">基于 MCP Server 35 个工具的能力地图，本项目已集成 / 可对接的部分</div></div>
  <div class="card">
    <div class="ct">已集成到看板</div>
    <div class="cd">以下能力已在本页面实现并使用真实接口数据</div>
    <div class="grid">
      <div class="feat"><div class="fi"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg" ><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFC72C"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">菜单浏览与打字搜索</div>
        <div class="fod"><code>query-meals</code><br>121 项门店实时菜单，15 个官方分类严格按官方顺序排列，支持关键词搜索与六维排序</div></div>
      <div class="feat"><div class="fi"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg" ><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFC72C"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">3D 食物模型舞台</div>
        <div class="fod">Three.js r128<br>按分类程序化建模，悬停聚焦、缩放高亮、邻项弱化；WebGL 不可用时自动降级为 2D 大图</div></div>
      <div class="feat"><div class="fi"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg" ><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFC72C"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">营养成分查询</div>
        <div class="fod"><code>list-nutrition-foods</code><br>61 项全国营养库，六大指标：能量、蛋白质、脂肪、碳水、钠、钙</div></div>
      <div class="feat"><div class="fi"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg" ><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFC72C"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">门店定位与推荐</div>
        <div class="fod"><code>query-nearby-stores</code><br>真实距离、营业状态、预约时段，支持步行/骑行/地铁/自驾加权</div></div>
      <div class="feat"><div class="fi"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg" ><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFC72C"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">麦金卡优惠比价</div>
        <div class="fod"><code>query-meals</code> discountType<br>识别「随单购麦金卡优惠」「促销优惠」，自动计算到手价与原价对比</div></div>
      <div class="feat"><div class="fi"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg" ><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFC72C"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">积分兑换计算</div>
        <div class="fod"><code>mall-points-products</code><br>按 downTime 过滤有效券，计算每积分折算价值，积分不足预警</div></div>
    </div>
  </div>
  <div class="card">
    <div class="ct">可对接（需实时调用，本页未接入）</div>
    <div class="cd">涉及实时查询或写操作，架构上已预留，需在 AI 侧编排</div>
    <div class="grid">
      <div class="feat" style="background:#FDFAF4"><div class="fic"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg"><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFFFFF"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">麦乐送全链路下单</div>
        <div class="fod"><code>delivery-query-addresses</code> → <code>delivery-query-stores</code> → <code>calculate-price</code> → <code>create-order</code><br><span style="color:var(--err)">写操作，须用户确认后执行</span></div></div>
      <div class="feat" style="background:#FDFAF4"><div class="fic"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg"><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFFFFF"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">一键领券 / 取消订单</div>
        <div class="fod"><code>auto-bind-coupons</code> <code>cancel-order</code><br><span style="color:var(--err)">写操作，须用户确认后执行</span></div></div>
      <div class="feat" style="background:#FDFAF4"><div class="fic"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg"><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFFFFF"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">积分抽奖</div>
        <div class="fod"><code>query-lottery-info</code> → <code>draw-lottery</code> → <code>query-my-prizes</code><br><span style="color:var(--err)">抽奖消耗积分，须确认</span></div></div>
      <div class="feat" style="background:#FDFAF4"><div class="fic"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg"><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFFFFF"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">主题活动预约</div>
        <div class="fod"><code>query-party-city</code> → <code>query-party-store</code> → <code>query-party-store-date</code> → <code>party-order-create</code><br>生日派对、品鉴会、麦麦体验营</div></div>
      <div class="feat" style="background:#FDFAF4"><div class="fic"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg"><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFFFFF"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">活动日历</div>
        <div class="fod"><code>campaign-calendar</code><br>当月营销活动日历，返回进行中 / 往期 / 未来活动</div></div>
      <div class="feat" style="background:#FDFAF4"><div class="fic"><svg viewBox="0 0 24 24" width="26" height="26" xmlns="http://www.w3.org/2000/svg"><path d="M17.243 3.006c2.066 0 3.742 8.714 3.742 19.478H24c0-11.588-3.042-20.968-6.766-20.968-2.127 0-4.007 2.81-5.248 7.227-1.241-4.416-3.121-7.227-5.231-7.227C3.031 1.516 0 10.888 0 22.476h3.014c0-10.763 1.658-19.47 3.724-19.47 2.066 0 3.741 8.05 3.741 17.98h2.997c0-9.93 1.684-17.98 3.75-17.98Z" fill="#FFFFFF"/></svg></div><div style="font-size:15px;font-weight:800;margin-bottom:6px">套餐特制与替换</div>
        <div class="fod"><code>query-meal-detail</code><br>套餐组成、选择题、特制选项（selectedKey / unselectedKey 规则）</div></div>
    </div>
  </div>
  <div class="card">
    <div class="ct">数据质量校验</div>
    <div class="cd">本项目在实测 MCP 数据时发现并处理的三个坑</div>
    <div class="fo"><div class="fot">① <code>status</code> 字段失真</div>
      <div class="fod"><code>mall-points-products</code> 的 <code>status</code> 全部返回「2-上架」，但 <code>downTime</code> 显示多数已过期。实测 25 条原始数据中 <b>16 条已下架</b>，真实有效仅 9 条。处理方式：改以 <code>downTime</code> 为准过滤。</div></div>
    <div class="fo"><div class="fot">② 热量与价格分属两套数据源</div>
      <div class="fod"><code>list-nutrition-foods</code> 是全国静态库，<b>无价格无门店维度</b>；<code>query-meals</code> 有价格但套餐类无营养数据。121 项菜单中仅 40 项（33%）有热量数据，配餐模块采用交集策略，套餐自动排除。</div></div>
    <div class="fo"><div class="fot">③ <code>calculate-price</code> 返回单位为「分」</div>
      <div class="fod">官方工具说明明确要求<b>展示时须除以 100</b>。任何未经过该接口回验的金额只能标注为「预估」，不得标注为「价格」。</div></div>
  </div>
</section>

<div class="foot">
  麦麦智配 · M-CODE 麦当劳程序员创意开发大赛参赛作品<br>
  数据来源：<code>M-China/mcd-mcp-server</code>（Streamable HTTP @ <code>https://mcp.mcd.cn</code>）· 数据抓取于 2026-10-12<br>
  标志为麦当劳官方矢量资产（simple-icons，CC0）· 品牌色 #FFC72C / #DA291C · 商标权利归麦当劳所有<br>
  本项目为参赛作品，非麦当劳官方产品 · 餐品信息与价格以官方渠道实时结果为准
</div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* ============================================================
   全局状态
   ============================================================ */
let D=null, CART={}, curCat='全部';
let VIEW=[], FOCUS=0, focusCode=null;
const cache={};

/* 统一渲染循环：离屏暂停 */
const VIS={hero:true,menu:true};
const io=new IntersectionObserver(es=>es.forEach(e=>{
  const k=e.target.id==='gl'?'hero':(e.target.id==='menu3d'?'menu':null);
  if(k)VIS[k]=e.isIntersecting;
}),{threshold:.02});
['gl','menu3d'].forEach(id=>{const el=document.getElementById(id);if(el)io.observe(el)});
function loop(){requestAnimationFrame(loop);
  if(VIS.hero&&heroTick)heroTick();
  if(VIS.menu&&menuTick)menuTick();}

/* ============================================================
   聚焦面板（纯 DOM，不依赖 WebGL —— 保证任何环境都能渲染）
   ============================================================ */
function renderFocusPanel(it,code){
  const off=it.originalPrice>it.currentPrice;
  const tags=(it.tags||[]).slice(0,4);
  const p=document.getElementById('focusPanel');
  if(!p)return;
  p.innerHTML=`
    <div class="focus-img${it.image?'':' off'}">${it.image?`<img src="${it.image}" alt="${it.name}" referrerpolicy="no-referrer">`:''}</div>
    <div class="focus-b">
      <div class="focus-n">${it.name}</div>
      <div class="focus-p">
        <span class="focus-pv">¥${it.currentPrice.toFixed(1)}</span>
        ${off?`<span class="focus-po">¥${it.originalPrice.toFixed(1)}</span><span class="focus-sv">省 ¥${(it.originalPrice-it.currentPrice).toFixed(1)}</span>`:''}
      </div>
      <div class="focus-m">
        ${it.kcal?`<span class="fm k">${it.kcal} 千卡${it.kcal>=500?' · 高热量':''}</span>`:'<span class="fm nocal">套餐无单项营养数据</span>'}
        ${it.discountType?`<span class="fm fg gold">${it.discountType}</span>`:''}
      </div>
      ${tags.length?`<div class="focus-t">${tags.map(x=>`<span class="fg${/爆款|人气/.test(x)?' hot':''}">${x}</span>`).join('')}</div>`:''}
      <button class="btn r" style="padding:11px 20px;font-size:13px" onclick="add('${code}')">加入比价</button>
    </div>`;
}

/* 2D 降级视图 */
function renderFb2d(it){
  const box=document.getElementById('fb2d'),img=document.getElementById('fb2dImg');
  if(!it.image){box.style.display='none';return}
  img.src=it.image; img.alt=it.name;
  box.style.display='flex';
}

/* ============================================================
   场景一：品牌区双拱门（失败则降级为静态官方标志）
   ============================================================ */
let heroTick=null;
(function(){
  const cv=document.getElementById('gl');
  if(!cv||!window.THREE){fallback();return}
  const size=()=>({W:cv.clientWidth||innerWidth,H:cv.clientHeight||290});
  let {W,H}=size(), renderer;
  try{renderer=new THREE.WebGLRenderer({canvas:cv,antialias:true,alpha:false,powerPreference:'high-performance'})}
  catch(e){fallback();return}
  function fallback(){cv.style.display='none';document.getElementById('heroFb').style.display='block';
    document.getElementById('htMode').textContent='官方矢量标志';}

  renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  renderer.setSize(W,H,false);
  const scene=new THREE.Scene();
  scene.background=new THREE.Color(0xDA291C);
  scene.fog=new THREE.Fog(0xDA291C,16,36);
  const cam=new THREE.PerspectiveCamera(46,W/H,.1,120);
  cam.position.set(-1.6,.4,13.5);

  scene.add(new THREE.AmbientLight(0xffffff,.5));
  const k1=new THREE.DirectionalLight(0xFFC72C,1.55);k1.position.set(5,7,8);scene.add(k1);
  const k2=new THREE.DirectionalLight(0xffffff,.55);k2.position.set(-6,2,-3);scene.add(k2);
  const rim=new THREE.PointLight(0xFFD98A,1,22);rim.position.set(0,-3,5);scene.add(rim);

  const gold=new THREE.MeshStandardMaterial({color:0xFFC72C,metalness:.78,roughness:.24});
  const goldD=new THREE.MeshStandardMaterial({color:0xE09A00,metalness:.7,roughness:.4});
  const archGroup=new THREE.Group();scene.add(archGroup);

  function buildArch(cx,scale){
    const g=new THREE.Group(), r=1.62;
    const tube=(a0,a1)=>{
      const pts=[];
      for(let i=0;i<=40;i++){const a=a0+(a1-a0)*i/40;
        pts.push(new THREE.Vector3(cx+Math.cos(a)*r,Math.sin(a)*r*1.35,0));}
      return new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts),48,scale,.5,10),gold);
    };
    g.add(tube(Math.PI,Math.PI*.5),tube(Math.PI*.5,0));
    [cx-r,cx+r].forEach(px=>{
      const m=new THREE.Mesh(new THREE.CylinderGeometry(scale*1.05,scale*1.05,3.1,14),gold);
      m.position.set(px,-3.05,0);g.add(m);});
    return g;
  }
  const A1=buildArch(-1.75,.42),A2=buildArch(1.75,.42);
  archGroup.add(A1,A2);
  archGroup.position.set(4.9,-.2,0);archGroup.rotation.y=-.4;

  const base=new THREE.Mesh(new THREE.BoxGeometry(9.5,.34,2.4),goldD);
  base.position.set(4.9,-4.6,0);scene.add(base);
  const glow=new THREE.Mesh(new THREE.BoxGeometry(10.8,.12,3.2),
    new THREE.MeshBasicMaterial({color:0xFFC72C,transparent:true,opacity:.26}));
  glow.position.set(4.9,-4.88,0);scene.add(glow);

  const floaters=[], box=new THREE.BoxGeometry(.6,.6,.6);
  for(let i=0;i<20;i++){
    const m=new THREE.Mesh(box,new THREE.MeshStandardMaterial({
      color:i%3===0?0xFFC72C:(i%3===1?0xFFFFFF:0xFFB612),metalness:.35,roughness:.5,transparent:true,opacity:.88}));
    m.position.set(-11+Math.random()*22,-4.5+Math.random()*10,-6+Math.random()*12);
    m.rotation.set(Math.random()*3,Math.random()*3,Math.random()*3);
    m.userData={sp:.2+Math.random()*.45,ph:Math.random()*6.28,ry:(Math.random()-.5)*.014};
    scene.add(m);floaters.push(m);
  }
  const pg=new THREE.BufferGeometry(),P=140,pa=new Float32Array(P*3);
  for(let i=0;i<P;i++){pa[i*3]=(Math.random()-.5)*32;pa[i*3+1]=(Math.random()-.5)*15;pa[i*3+2]=(Math.random()-.5)*15-4}
  pg.setAttribute('position',new THREE.BufferAttribute(pa,3));
  const pts=new THREE.Points(pg,new THREE.PointsMaterial({color:0xFFD98A,size:.13,transparent:true,opacity:.6}));
  scene.add(pts);

  let mx=0,my=0;
  cv.addEventListener('pointermove',e=>{const r=cv.getBoundingClientRect();
    mx=((e.clientX-r.left)/r.width-.5)*2;my=((e.clientY-r.top)/r.height-.5)*2});
  cv.addEventListener('pointerleave',()=>{mx=my=0});

  let t=0;
  heroTick=function(){
    t+=.012;
    archGroup.rotation.y=-.4+Math.sin(t*.45)*.14+mx*.26;
    archGroup.rotation.x=my*.07;
    archGroup.position.y=-.2+Math.sin(t*.9)*.13;
    A1.rotation.z=Math.sin(t*1.1)*.012;A2.rotation.z=-Math.sin(t*1.1+.6)*.012;
    floaters.forEach(m=>{m.position.y+=Math.sin(t+m.userData.ph)*m.userData.sp*.016;
      m.rotation.y+=m.userData.ry;m.rotation.x+=.002});
    pts.rotation.y=t*.026;
    cam.position.x+=((mx*1.2)-1.6)*.045;
    cam.position.y+=((.4-my*.7)-cam.position.y)*.045;
    cam.lookAt(0,0,0);
    renderer.render(scene,cam);
  };
  addEventListener('resize',()=>{const s=size();W=s.W;H=s.H;
    renderer.setSize(W,H,false);cam.aspect=W/H;cam.updateProjectionMatrix()});
})();

/* ============================================================
   场景二：3D 食物模型舞台（失败则降级 2D 大图）
   ============================================================ */
let menuTick=null;
function initMenu3D(){
  const cv=document.getElementById('menu3d');
  const degrade=()=>{
    cv.style.display='none';
    document.getElementById('fb2d').style.display='flex';
    document.getElementById('stageHint').textContent='当前环境不支持 WebGL · 已降级为 2D 大图模式';
    document.getElementById('htMode').textContent='2D 降级模式';
  };
  if(!cv||!window.THREE){degrade();return}
  const size=()=>({W:cv.clientWidth||1200,H:cv.clientHeight||400});
  let {W,H}=size(), renderer;
  try{renderer=new THREE.WebGLRenderer({canvas:cv,antialias:true,alpha:true})}
  catch(e){degrade();return}

  renderer.setPixelRatio(Math.min(devicePixelRatio,2));
  renderer.setSize(W,H,false);
  const scene=new THREE.Scene();
  const cam=new THREE.PerspectiveCamera(42,W/H,.1,100);
  cam.position.set(0,.6,9.2);cam.lookAt(0,0,0);

  scene.add(new THREE.AmbientLight(0xffffff,.62));
  const key=new THREE.DirectionalLight(0xFFE9C0,1.25);key.position.set(3,6,7);scene.add(key);
  const fill=new THREE.DirectionalLight(0xffffff,.5);fill.position.set(-5,1,4);scene.add(fill);
  const spot=new THREE.PointLight(0xFFC72C,1.5,14);spot.position.set(0,1.6,3.2);scene.add(spot);
  const under=new THREE.PointLight(0xDA291C,.5,10);under.position.set(0,-2.5,2);scene.add(under);

  const ring=new THREE.Mesh(new THREE.TorusGeometry(2.05,.055,10,64),
    new THREE.MeshBasicMaterial({color:0xFFC72C,transparent:true,opacity:.85}));
  ring.rotation.x=Math.PI/2;ring.position.y=-1.62;scene.add(ring);
  const ring2=new THREE.Mesh(new THREE.TorusGeometry(2.45,.03,10,64),
    new THREE.MeshBasicMaterial({color:0xDA291C,transparent:true,opacity:.4}));
  ring2.rotation.x=Math.PI/2;ring2.position.y=-1.66;scene.add(ring2);
  const shadow=new THREE.Mesh(new THREE.CircleGeometry(2.1,48),
    new THREE.MeshBasicMaterial({color:0x8A5B18,transparent:true,opacity:.13}));
  shadow.rotation.x=-Math.PI/2;shadow.position.y=-1.6;scene.add(shadow);

  const M={};
  ['bun','bunT','patty','chicken','cheese','lettuce','tomato','fish','fry','box','boxY','cup','coffee','soda','ice','cone','pie','steel','toy','apple','corn']
    .forEach(k=>M[k]=new THREE.MeshStandardMaterial({
      color:{bun:0xE8A85C,bunT:0xD89348,patty:0x5A3A22,chicken:0xC9762F,cheese:0xFFC72C,lettuce:0x7FB344,
        tomato:0xDA291C,fish:0xE6D9B8,fry:0xFFD166,box:0xDA291C,boxY:0xFFC72C,cup:0xFFFFFF,coffee:0x4A2C17,
        soda:0x8B2E1E,ice:0xF6E7CC,cone:0xC98850,pie:0xE3B061,steel:0xD8D8D8,toy:0xFFC72C,apple:0xC0392B,corn:0xF5D76E}[k],
      roughness:{bun:.72,bunT:.75,patty:.62,chicken:.55,cheese:.35,lettuce:.6,tomato:.5,fish:.6,fry:.55,box:.45,
        boxY:.45,cup:.35,coffee:.3,soda:.28,ice:.5,cone:.7,pie:.6,steel:.3,toy:.4,apple:.5,corn:.6}[k],
      metalness:{bun:.05,bunT:.05,patty:.08,chicken:.06,cheese:.1,lettuce:.05,tomato:.05,fish:.05,fry:.05,box:.1,
        boxY:.1,cup:.05,coffee:.1,soda:.12,ice:.05,cone:.05,pie:.05,steel:.75,toy:.15,apple:.05,corn:.05}[k]}));
  const mk=(g,m,x=0,y=0,z=0)=>{const me=new THREE.Mesh(g,m);me.position.set(x,y,z);return me};

  /* ---- 程序化建模 ---- */
  function buildFood(it){
    const n=it.name||'', cat=(it.cat||'').replace(/\\n/g,' ');
    const g=new THREE.Group();
    const has=s=>n.includes(s);
    const isCombo=/三件套|四件套|单人餐|分享餐|套餐|随心配|亲子/.test(n);

    if(/酱$/.test(n)||(has('蘸酱')&&/酱/.test(n)&&!/鸡|翅|块/.test(n))){addSauceCup(g);return g}
    if(has('拼盘')||has('四宫格')||has('双全盒')||has('十翅')||has('多人餐')||has('分享餐')){addSnackBox(g,1.15);return g}
    if(isCombo&&!/冰淇淋|圆筒|新地|麦旋风|派|薯条|玉米|苹果|咖啡|红茶|美式|可乐|雪碧|牛奶|豆浆/.test(n)){
      addBurger(g,.82);addFries(g,.55,1.55,-.55,-.9);addDrink(g,.5,-1.75,-.5,-.9);
      g.position.y=.1;g.scale.setScalar(.95);return g;
    }
    if(has('随心配')){addBurger(g,.62,0,.15,0);addFries(g,.42,1.5,.1);g.scale.setScalar(.8);return g}
    if(/堡/.test(n)||cat.includes('汉堡')||cat.includes('厚牛堡')){
      const f=has('麦香鱼')||has('鳕鱼')||has('鱼排')?'fish':(has('麦香鸡')?'chicken':(has('板烧')?'chicken':(has('吉士')?'cheese':'beef')));
      addBurger(g,1,0,0,0,f);return g;
    }
    if(cat.includes('炸鸡')||has('鸡翅')||has('脆汁鸡')||has('鸡块')||has('麦乐鸡')||has('V翅')||has('鸡排')||has('那么大')){
      addDrumstick(g);g.scale.setScalar(1.05);return g;
    }
    if(has('薯条')||has('脆薯')){addFries(g,1);return g}
    if(has('薯饼')){addHashBrown(g);return g}
    if(has('玉米')){addCorn(g);return g}
    if(has('苹果片')){addApple(g);return g}
    if(cat.includes('小食')||has('洋葱圈')||has('沙拉')){addSnackBox(g);return g}
    if(cat.includes('咖啡')||has('咖啡')||has('美式')||has('拿铁')||has('卡布')||has('奶铁')||has('阿芙佳朵')||has('鲜萃')){addCoffee(g);return g}
    if(cat.includes('饮品')||has('可乐')||has('雪碧')||has('红茶')||has('牛奶')||has('豆浆')||has('橙')||has('柠檬')||has('纯悦')||has('怡泉')||has('苹果汁')){
      addDrink(g,0,0,0,has('可乐')?'soda':'milk');return g;
    }
    if(has('派')){addPie(g);return g}
    if(has('冰淇淋')||has('圆筒')||has('新地')||has('麦旋风')||has('雪冰')||cat.includes('甜品')){addIceCream(g);return g}
    if(cat.includes('开心乐园')){addHappyBox(g);return g}
    addSnackBox(g);return g;
  }

  function addBurger(g,s=1,y=0,fill='beef'){
    g.add(mk(new THREE.CylinderGeometry(1.05*s,.95*s,.34*s,26),M.bun,0,y+.62*s,0));
    if(fill==='fish')g.add(mk(new THREE.BoxGeometry(1.5*s,.2*s,1.3*s),M.fish,0,y+.42*s,0));
    else if(fill==='chicken')g.add(mk(new THREE.CylinderGeometry(.92*s,.9*s,.3*s,24),M.chicken,0,y+.42*s,0));
    else if(fill==='cheese')g.add(mk(new THREE.CylinderGeometry(.9*s,.9*s,.26*s,24),M.cheese,0,y+.4*s,0));
    else{g.add(mk(new THREE.CylinderGeometry(.94*s,.92*s,.3*s,24),M.patty,0,y+.42*s,0));
         g.add(mk(new THREE.CylinderGeometry(.88*s,.86*s,.24*s,24),M.patty,0,y+.16*s,0));}
    const lt=mk(new THREE.TorusGeometry(.74*s,.15*s,8,20),M.lettuce,0,y+.58*s,0);lt.rotation.x=Math.PI/2;g.add(lt);
    g.add(mk(new THREE.CylinderGeometry(.86*s,.86*s,.09*s,22),M.tomato,0,y+.24*s,0));
    const top=mk(new THREE.SphereGeometry(1.02*s,26,14,0,Math.PI*2,0,Math.PI/2),M.bun,0,y+.7*s,0);top.scale.y=.62;g.add(top);
    for(let i=0;i<7;i++){const a=Math.PI*2*i/7;
      const sd=mk(new THREE.SphereGeometry(.055*s,6,5),M.bunT,Math.cos(a)*.6*s,y+.92*s,Math.sin(a)*.6*s);
      sd.scale.y=.4;g.add(sd);}
    g.add(mk(new THREE.CylinderGeometry(.98*s,1.02*s,.26*s,26),M.bunT,0,y-.02*s,0));
  }
  function addFries(g,s=1,x=0,y=0,z=0){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.BoxGeometry(1.1*s,1.5*s,1.0*s),M.box,x,y+.75*s,z));
    grp.add(mk(new THREE.BoxGeometry(1.14*s,.16*s,1.04*s),M.boxY,x,y+1.5*s,z));
    for(let i=0;i<9;i++){
      const a=(i/9-.5)*1.1;
      const st=mk(new THREE.BoxGeometry(.13*s,1.25*s,.13*s),M.fry,x+a*.55*s,y+1.5*s+Math.sin(i)*.06*s,z+a*.42*s);
      st.rotation.z=(Math.random()-.5)*.16;st.rotation.x=(Math.random()-.5)*.12;grp.add(st);}
    g.add(grp);
  }
  function addDrink(g,s=1,x=0,y=0,z=0,kind='soda'){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.CylinderGeometry(.62*s,.5*s,1.55*s,24),M.cup,x,y+.78*s,z));
    grp.add(mk(new THREE.CylinderGeometry(.64*s,.52*s,.3*s,24),kind==='soda'?M.soda:M.coffee,x,y+.85*s,z));
    grp.add(mk(new THREE.CylinderGeometry(.66*s,.66*s,.14*s,24),M.boxY,x,y+1.6*s,z));
    const straw=mk(new THREE.CylinderGeometry(.06*s,.06*s,1.1*s,10),M.box,x+.22*s,y+2.0*s,z);
    straw.rotation.z=.28;grp.add(straw);
    g.add(grp);
  }
  function addCoffee(g){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.CylinderGeometry(.6,.48,1.3,24),M.cup,0,.65,0));
    grp.add(mk(new THREE.CylinderGeometry(.62,.5,.26,24),M.box,0,.7,0));
    grp.add(mk(new THREE.CylinderGeometry(.64,.64,.12,24),M.steel,0,1.34,0));
    for(let i=0;i<3;i++){const a=i*.9;
      const st=mk(new THREE.TorusGeometry(.3,.03,6,16,Math.PI),M.coffee,0,1.2,0);
      st.position.set(Math.cos(a)*.18,1.2,Math.sin(a)*.18);st.rotation.y=a;grp.add(st);}
    g.add(grp);
  }
  function addDrumstick(g){
    const grp=new THREE.Group();
    const meat=mk(new THREE.SphereGeometry(.95,24,18),M.chicken,0,.85,0);meat.scale.set(1,.82,1);grp.add(meat);
    const cr=mk(new THREE.SphereGeometry(.5,18,14),M.chicken,0,1.25,0);cr.scale.set(1,.55,1);grp.add(cr);
    grp.add(mk(new THREE.CylinderGeometry(.15,.12,1.0,12),M.bunT,0,-.35,0));
    const knb=mk(new THREE.SphereGeometry(.2,12,10),M.bunT,0,-.9,0);knb.scale.set(1,1.5,1);grp.add(knb);
    for(let i=0;i<4;i++){const a=Math.PI*2*i/4;
      grp.add(mk(new THREE.SphereGeometry(.13,10,8),M.tomato,Math.cos(a)*.6,1.0+Math.sin(i)*.15,Math.sin(a)*.6));}
    g.add(grp);
  }
  function addSauceCup(g){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.CylinderGeometry(.52,.42,.62,20),M.box,0,.31,0));
    const rim=mk(new THREE.TorusGeometry(.52,.045,8,22),M.steel,0,.6,0);rim.rotation.x=Math.PI/2;grp.add(rim);
    grp.add(mk(new THREE.CylinderGeometry(.46,.4,.2,20),M.tomato,0,.55,0));
    grp.add(mk(new THREE.CylinderGeometry(.54,.54,.07,20),M.boxY,0,.68,0));
    g.add(grp);
  }
  function addHashBrown(g){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.CylinderGeometry(.85,.9,.42,22),M.pie,0,.21,0));
    for(let i=0;i<10;i++){const a=Math.PI*2*i/10;
      const d=mk(new THREE.BoxGeometry(.16,.06,.3),M.pie,Math.cos(a)*.5,.42,Math.sin(a)*.5);d.rotation.y=-a;grp.add(d);}
    g.add(grp);
  }
  function addCorn(g){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.CylinderGeometry(.62,.5,1.1,22),M.cup,0,.55,0));
    const kc=mk(new THREE.SphereGeometry(.55,18,14),M.corn,0,1.15,0);kc.scale.y=.7;grp.add(kc);
    for(let i=0;i<12;i++){const a=Math.PI*2*i/12;
      grp.add(mk(new THREE.SphereGeometry(.09,8,6),M.corn,Math.cos(a)*.42,1.05+Math.sin(i*2)*.06,Math.sin(a)*.42));}
    g.add(grp);
  }
  function addApple(g){
    const grp=new THREE.Group();
    const ap=mk(new THREE.SphereGeometry(.72,20,16),M.apple,0,.8,0);ap.scale.set(1,.88,1);grp.add(ap);
    grp.add(mk(new THREE.CylinderGeometry(.04,.04,.3,8),M.bunT,0,1.48,0));
    const lf=mk(new THREE.SphereGeometry(.16,10,8),M.lettuce,.2,1.5,0);lf.scale.set(1.6,.4,.8);grp.add(lf);
    g.add(grp);
  }
  function addSnackBox(g,s=1){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.BoxGeometry(1.5*s,.95*s,1.1*s),M.boxY,0,.48*s,0));
    grp.add(mk(new THREE.BoxGeometry(1.54*s,.1*s,1.14*s),M.box,0,1.0*s,0));
    for(let i=0;i<3;i++){
      const b=mk(new THREE.SphereGeometry(.3*s,14,12),M.chicken,-.4*s+i*.4*s,.35*s,.1*s);b.scale.set(1,.8,1);grp.add(b);}
    g.add(grp);
  }
  function addPie(g){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.CylinderGeometry(.85,.8,.55,24),M.pie,0,.28,0));
    const top=mk(new THREE.SphereGeometry(.85,22,12,0,Math.PI*2,0,Math.PI/2),M.bun,0,.55,0);top.scale.y=.5;grp.add(top);
    const seam=mk(new THREE.TorusGeometry(.85,.04,8,26),M.bunT,0,.55,0);seam.rotation.x=Math.PI/2;grp.add(seam);
    g.add(grp);
  }
  function addIceCream(g){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.CylinderGeometry(.42,.14,.95,20),M.cone,0,.48,0));
    grp.add(mk(new THREE.SphereGeometry(.46,20,16),M.ice,0,1.18,0));
    grp.add(mk(new THREE.SphereGeometry(.3,16,14),M.ice,0,1.55,0));
    grp.add(mk(new THREE.SphereGeometry(.12,10,8),M.coffee,0,1.85,0));
    g.add(grp);
  }
  function addHappyBox(g){
    const grp=new THREE.Group();
    grp.add(mk(new THREE.BoxGeometry(1.7,1.1,1.2),M.box,0,.55,0));
    grp.add(mk(new THREE.BoxGeometry(1.74,.14,1.24),M.boxY,0,1.16,0));
    const arc=mk(new THREE.TorusGeometry(.34,.06,8,20,Math.PI),M.toy,0,1.0,.62);grp.add(arc);
    grp.add(mk(new THREE.SphereGeometry(.16,12,10),M.toy,0,.78,.62));
    grp.add(mk(new THREE.CylinderGeometry(.3,.28,.2,16),M.bun,-.42,.62,0));
    g.add(grp);
  }

  /* ---- 舞台管理 ---- */
  let focusGroup=null, t=0, mx=0, my=0;
  const neighbours=[];
  cv.addEventListener('pointermove',e=>{const r=cv.getBoundingClientRect();
    mx=((e.clientX-r.left)/r.width-.5)*2;my=((e.clientY-r.top)/r.height-.5)*2});
  cv.addEventListener('pointerleave',()=>{mx=my=0});

  function disposeGroup(gr){scene.remove(gr)}

  function setFocus(code){
    const it=cache[code];if(!it)return;
    if(focusGroup){const old=focusGroup;old.userData.dying=true;
      (function fade(){old.userData.f-=.06;old.scale.setScalar(Math.max(.001,old.userData.f));
        if(old.userData.f>0)requestAnimationFrame(fade);else disposeGroup(old);})();}
    const g=buildFood(it);
    g.userData={f:0,dying:false,seed:Math.random()*6.28};
    scene.add(g);focusGroup=g;
    neighbours.forEach(n=>disposeGroup(n.group));neighbours.length=0;
    const idx=VIEW.indexOf(code);
    for(let d=-3;d<=3;d++){
      if(d===0)continue;
      const j=idx+d;if(j<0||j>=VIEW.length)continue;
      const ng=buildFood(cache[VIEW[j]]);
      ng.userData={slot:d,phase:Math.random()*6.28,f:0};
      ng.scale.setScalar(.001);scene.add(ng);neighbours.push({group:ng,slot:d});
    }
  }

  menuTick=function(){
    t+=.016;
    if(focusGroup){
      const u=focusGroup.userData;
      u.f=Math.min(1,u.f+.07);
      const e=1-Math.pow(1-u.f,3);
      focusGroup.scale.setScalar(e);
      focusGroup.position.set(mx*.34,.1+Math.sin(t*1.1+u.seed)*.1,-Math.max(0,-my*.3));
      focusGroup.rotation.y=Math.sin(t*.55+u.seed)*.32+mx*.22;
      focusGroup.rotation.x=Math.sin(t*.8)*.05;
    }
    neighbours.forEach(n=>{
      const u=n.group.userData;
      u.f=Math.min(1,u.f+.06);
      const e=1-Math.pow(1-u.f,3), d=u.slot, ad=Math.abs(d);
      n.group.position.lerp({x:d*1.62,y:-.15+Math.sin(t*.9+u.phase)*.06,z:-1.5-ad*.75},.12);
      n.group.scale.setScalar(e*(.42-ad*.055));
      n.group.rotation.y=Math.sin(t*.4+u.phase)*.4+d*.2;
      n.group.traverse(o=>{if(o.material){o.material.transparent=true;o.material.opacity=.38-ad*.05}});
    });
    ring.material.opacity=.55+Math.sin(t*1.6)*.2;
    ring2.material.opacity=.3+Math.sin(t*1.6+1)*.14;
    ring.rotation.z=t*.3;
    spot.position.x=mx*.8;spot.position.y=1.6+my*.4;
    cam.position.x+=(mx*.42-cam.position.x)*.05;
    cam.position.y+=((.6-my*.28)-cam.position.y)*.05;
    cam.lookAt(0,.05,0);
    renderer.render(scene,cam);
  };

  addEventListener('resize',()=>{const s=size();W=s.W;H=s.H;
    renderer.setSize(W,H,false);cam.aspect=W/H;cam.updateProjectionMatrix()});

  window.__menu3d={setFocus:setFocus,ok:true};
}

/* ============================================================
   看板逻辑
   ============================================================ */
function init(){
  document.getElementById('s1').textContent=Object.keys(D.menu).length;
  document.getElementById('s2').textContent=Object.keys(D.nutrition).length;

  const cats=[{name:'全部',codes:D.menuGlobalOrder}].concat(D.menuOrder);
  document.getElementById('cats').innerHTML=cats.map(c=>
    `<button class="chip${c.name==='全部'?' on':''}" onclick="setCat(this)" data-c="${c.name}">${c.name}<span class="n">${c.codes.length}</span></button>`).join('');

  const hot=['巨无霸','板烧鸡腿堡','麦辣鸡腿汉堡','圆筒冰淇淋','中薯条','燕麦奶铁'];
  document.getElementById('q2chips').innerHTML=hot.map(h=>
    `<button class="chip" onclick="document.getElementById('q2').value='${h}';doSearch()">${h}</button>`).join('');
  document.getElementById('ap').textContent=D.account.availablePoint;

  const pp=D.pointsProducts.filter(p=>new Date(p.downTime.replace(' ','T'))>new Date());
  document.getElementById('pCan').textContent=pp.length;
  document.getElementById('pBest').textContent=Math.min(...pp.map(p=>p.point));
  document.getElementById('pLack').textContent=pp.filter(p=>p.point>D.account.availablePoint).length;
  document.getElementById('ptable').innerHTML=
    `<thead><tr><th>商品</th><th>积分</th><th>面值</th><th>每积分折算</th><th>状态</th></tr></thead><tbody>`+
    pp.map(p=>{
      const v=parseFloat(p.selling.match(/([\d.]+)元/)[1])/p.point;
      const ok=p.point<=D.account.availablePoint;
      const bw=Math.min(100,parseFloat(p.selling.match(/([\d.]+)元/)[1])/22*100);
      return `<tr><td><b>${p.spuName}</b><br><span style="font-size:11px;color:var(--ink3)">ID ${p.spuId} · 截止 ${p.downTime.slice(0,10)}</span></td>
        <td><b>${p.point}</b></td><td>${p.selling.match(/([\d.]+)元/)[1]} 元</td>
        <td><b style="color:${v>=.1?'var(--ok)':'var(--ink3)'}">${v.toFixed(3)} 元</b>
        <div class="bar" style="width:80px"><div class="barf" style="width:${bw}%;background:${v>=.1?'var(--ok)':'var(--mc-yellow)'}"></div></div></td>
        <td>${ok?'<span class="pill">可兑</span>':'<span style="color:var(--err);font-size:12.5px">差 '+(p.point-D.account.availablePoint).toFixed(1)+'</span>'}</td></tr>`}).join('')+'</tbody>';
  document.getElementById('cpC').innerHTML=D.coupons.claimed.map(c=>`<span class="fg">${c}</span>`).join('');
  document.getElementById('cpA').innerHTML=D.coupons.claimable.map(c=>`<span class="fg hot">${c}</span>`).join('');
  renderCart();

  curCat='全部';VIEW=D.menuGlobalOrder.slice();
  render();
  loop();
}

document.querySelectorAll('nav button').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('nav button').forEach(x=>x.classList.remove('on'));
  document.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));
  b.classList.add('on');document.getElementById(b.dataset.t).classList.add('on');
  scrollTo({top:0,behavior:'smooth'});
});

function setCat(btn){
  curCat=btn.dataset.c;
  document.querySelectorAll('#cats .chip').forEach(x=>x.classList.remove('on'));
  btn.classList.add('on');render();
}

function currentCodes(){
  const q=(document.getElementById('q').value||'').trim().toLowerCase();
  const base=curCat==='全部'?D.menuGlobalOrder:D.menuOrder.find(c=>c.name===curCat).codes;
  if(!q)return base;
  return base.filter(c=>{const m=D.menu[c];
    return m.name.toLowerCase().includes(q)||(m.tags||[]).some(t=>t.toLowerCase().includes(q))});
}

function render(){
  VIEW=currentCodes();
  const catName=curCat==='全部'?'全部餐品':curCat;
  document.getElementById('stageCat').textContent=catName;
  document.getElementById('stripT').textContent=catName;
  document.getElementById('cnt').textContent=VIEW.length;
  document.getElementById('stripC').textContent=VIEW.length+' 项 · 官方顺序';
  renderStrip();
  if(VIEW.length)focusAt(0);

  const s=document.getElementById('sort').value;
  let items=VIEW.map(c=>({code:c,...D.menu[c]}));
  if(s==='price')items.sort((a,b)=>a.currentPrice-b.currentPrice);
  if(s==='priceDesc')items.sort((a,b)=>b.currentPrice-a.currentPrice);
  if(s==='save')items.sort((a,b)=>(b.originalPrice-b.currentPrice)/b.originalPrice-(a.originalPrice-a.currentPrice)/a.originalPrice);
  if(s==='kcalAsc')items.sort((a,b)=>(a.kcal??1e9)-(b.kcal??1e9));
  if(s==='kcalDesc')items.sort((a,b)=>(b.kcal??-1)-(a.kcal??-1));
  document.getElementById('list').innerHTML=items.length?items.map(i=>{
    const off=i.originalPrice>i.currentPrice;
    const hot=(i.tags||[]).some(t=>/爆款|人气/.test(t));
    return `<div class="mi"><div class="mimg">${i.image?`<img src="${i.image}" alt="${i.name}" loading="lazy" referrerpolicy="no-referrer">`:''}
      ${hot?'<span class="mflag">爆款</span>':''}${off?`<span class="moff">省${(i.originalPrice-i.currentPrice).toFixed(1)}</span>`:''}</div>
      <div class="mbody"><div class="mn">${i.name}</div>
      <div class="mp"><span class="mpv">¥${i.currentPrice.toFixed(1)}</span>${off?`<span class="mpo">¥${i.originalPrice.toFixed(1)}</span>`:''}</div>
      ${i.kcal?`<div class="mkc">${i.kcal} 千卡${i.kcal>=500?' · 高热量':''}</div>`:'<div class="mkc nocal">套餐无单项营养数据</div>'}
      ${i.discountType?`<div class="mkc fg gold">${i.discountType}</div>`:''}
      <button class="madd" onclick="add('${i.code}')">加入比价</button></div></div>`}).join('')
    :'<div class="empty" style="grid-column:1/-1"><div class="emptyi">🍔</div>没有匹配的餐品<br>试试「鸡」「堡」「咖啡」「麦旋风」</div>';
}

function renderStrip(){
  document.getElementById('strip').innerHTML=VIEW.map((c,i)=>{const m=D.menu[c];
    return `<button class="tile" data-code="${c}" onmouseenter="hoverTile(this)" onclick="pickTile(this)">
      <span class="tile-idx">${i+1}</span>
      <img src="${m.image||''}" alt="${m.name}" loading="lazy" referrerpolicy="no-referrer" onerror="this.style.visibility='hidden'">
      <div class="tile-n">${m.name}</div></button>`}).join('');
}

/* 聚焦：3D 与 2D 降级都走这里，保证面板必然渲染 */
function focusAt(i){
  if(i<0||i>=VIEW.length)return;
  FOCUS=i;const code=VIEW[i],it=D.menu[code];
  focusCode=code;
  renderFocusPanel(it,code);
  renderFb2d(it);
  if(window.__menu3d)window.__menu3d.setFocus(code);
  const strip=document.getElementById('strip');
  [...strip.children].forEach((el,j)=>el.classList.toggle('on',j===i));
  const on=strip.children[i];
  if(on)on.scrollIntoView({block:'nearest',inline:'center',behavior:'smooth'});
}
function hoverTile(el){const c=el.dataset.code;if(focusCode!==c)focusAt(VIEW.indexOf(c))}
function pickTile(el){hoverTile(el)}

function doSearch(){
  const q=(document.getElementById('q2').value||'').trim(),o=document.getElementById('searchOut');
  if(!q){o.innerHTML='';return}
  const nut=D.nutrition[q]||D.nutrition[Object.keys(D.nutrition).find(k=>q.length>1&&k.includes(q))];
  const menu=Object.values(D.menu).find(m=>m.name===q)||Object.values(D.menu).find(m=>m.name.includes(q));
  const pts=D.pointsProducts.filter(p=>p.point<=D.account.availablePoint&&new Date(p.downTime.replace(' ','T'))>new Date());
  let h='';
  if(menu)h+=`<div class="card"><div class="ct">${menu.name}</div>
    <div class="cd">门店实时售价 · ${menu.cat.replace(/\\n/g,' ')}</div>
    <div class="row" style="margin-bottom:4px">${menu.image?`<img src="${menu.image}" style="width:150px;height:150px;object-fit:cover;border-radius:14px" referrerpolicy="no-referrer">`:''}
    <div style="flex:1;min-width:200px"><div class="sgrid">
      <div class="stat mc"><div class="statv">¥${menu.currentPrice.toFixed(1)}</div><div class="statl">当前售价</div></div>
      <div class="stat"><div class="statv" style="color:var(--mc-red)">${menu.kcal??'—'}</div><div class="statl">热量 kcal</div></div>
      <div class="stat"><div class="statv">${menu.originalPrice>menu.currentPrice?Math.round((1-menu.currentPrice/menu.originalPrice)*100)+'%':'—'}</div><div class="statl">折扣力度</div></div></div></div></div></div>`;
  if(nut)h+=`<div class="card"><div class="ct">${q} · 营养成分</div>
    <div class="cd">数据源 MCP <code>list-nutrition-foods</code>（全国营养库，每份计）</div>
    <div class="sgrid">
    <div class="stat mc"><div class="statv">${nut.kcal}</div><div class="statl">能量 kcal</div></div>
    <div class="stat"><div class="statv">${nut.protein}g</div><div class="statl">蛋白质</div></div>
    <div class="stat"><div class="statv">${nut.fat}g</div><div class="statl">脂肪</div></div>
    <div class="stat"><div class="statv">${nut.carb}g</div><div class="statl">碳水</div></div>
    <div class="stat"><div class="statv">${nut.sodium}</div><div class="statl">钠 mg</div></div>
    <div class="stat"><div class="statv">${nut.calcium}</div><div class="statl">钙 mg</div></div></div>
    <div class="note w" style="margin-top:14px"><b>营养参考：</b>成年人每日推荐摄入约 2000–2400 千卡。单一餐品超过全天推荐量 30% 时建议搭配低热量饮品。</div></div>`;
  if(!nut&&!menu)h+=`<div class="card"><div class="empty"><div class="emptyi">🔍</div>未找到「${q}」<br><span style="font-size:12.5px">营养库与门店菜单均无此条目，可尝试更短的关键词</span></div></div>`;
  h+=`<div class="card"><div class="ct">积分兑换方案</div>
    <div class="cd">你当前有 ${D.account.availablePoint} 可用积分，以下可立即兑换</div>
    <div class="tw"><table><thead><tr><th>兑换内容</th><th>需积分</th><th>面值</th></tr></thead><tbody>
    ${pts.slice(0,5).map(p=>`<tr><td>${p.spuName}</td><td><b>${p.point}</b></td><td>${p.selling.match(/([\d.]+)元/)[1]} 元</td></tr>`).join('')}
    </tbody></table></div>
    <div class="note o" style="margin-top:14px">免费领取的优惠券价值通常高于积分兑换，建议<b>先领券再考虑积分</b>。</div></div>`;
  o.innerHTML=h;
}

function setT(v){document.getElementById('target').value=v;planKcal()}

function planKcal(){
  const T=+document.getElementById('target').value,tol=+document.getElementById('tol').value;
  const s=document.getElementById('ksort').value,o=document.getElementById('kcalOut');
  if(!T||T<100){o.innerHTML='<div class="card"><div class="note e">请输入 100–3000 之间的目标热量</div></div>';return}
  const pool=D.menuGlobalOrder.map(c=>({code:c,...D.menu[c]})).filter(m=>m.kcal&&m.kcal>0&&!m.name.includes('酱'));
  const res=[];
  for(let i=0;i<pool.length;i++)for(let j=i;j<pool.length;j++)for(let k=j;k<pool.length;k++){
    const set=[pool[i],pool[j],pool[k]].filter((x,idx,a)=>a.findIndex(y=>y.code===x.code)===idx);
    if(set.length<2||set.length>3)continue;
    const kcal=set.reduce((x,y)=>x+y.kcal,0);
    if(kcal<T*(1-tol)||kcal>T*(1+tol))continue;
    const price=set.reduce((x,y)=>x+y.currentPrice,0);
    res.push({set,kcal,price,per:price/kcal});
  }
  if(!res.length){o.innerHTML=`<div class="card"><div class="note w">在 ±${Math.round(tol*100)}% 容差内没有找到 2–3 品组合。建议放宽容差或调整目标热量。</div></div>`;return}
  res.sort((a,b)=>s==='price'?a.price-b.price:a.per-b.per);
  const used=new Set(),picks=[];
  for(const r of res){const key=r.set.map(x=>x.code).sort().join('|');if(!used.has(key)){used.add(key);picks.push(r)}}
  o.innerHTML=`<div class="card"><div class="ct">配餐方案 · 目标 ${T} 千卡</div>
    <div class="cd">命中 ${res.length} 种组合，展示前 ${Math.min(picks.length,6)} 种 · 容差 ±${Math.round(tol*100)}%</div>
    ${picks.slice(0,6).map((p,i)=>`<div class="rk">
      <div class="rkh"><div><div class="rkt">方案 ${i+1}${i===0?`<span class="badge-best">${s==='price'?'最低价':'最划算'}</span>`:''}</div>
      <div class="stl">${p.kcal} 千卡 · 占比全天推荐 ${(p.kcal/2300*100).toFixed(0)}%</div></div>
      <div style="text-align:right"><div class="rkp">¥${p.price.toFixed(1)}</div><div class="stl">¥${p.per.toFixed(4)}/千卡</div></div></div>
      <table><thead><tr><th>餐品</th><th>热量</th><th>单价</th></tr></thead><tbody>
      ${p.set.map(x=>`<tr><td>${x.name}</td><td style="color:var(--mc-red);font-weight:700">${x.kcal} kcal</td><td>¥${x.currentPrice.toFixed(1)}</td></tr>`).join('')}
      </tbody></table>
      <button class="chip" style="margin-top:11px" onclick='addAll(${JSON.stringify(p.set.map(x=>x.code))})'>加入比价</button>
    </div>`).join('')}
    <div class="note w"><b>口径说明：</b>价格为门店菜单 <code>query-meals</code> 实时售价，未叠加优惠券与麦金卡优惠。最终下单金额须经 <code>calculate-price</code> 官方回验。</div></div>`;
}

function add(c){CART[c]=(CART[c]||0)+1;renderCart()}
function addAll(cs){cs.forEach(c=>CART[c]=(CART[c]||0)+1);renderCart();document.querySelector('[data-t=coupon]').click()}
function clearCart(){CART={};renderCart();document.getElementById('couponOut').innerHTML=''}

function renderCart(){
  const ks=Object.keys(CART);
  document.getElementById('cartList').innerHTML=ks.length?
    `<div class="tw"><table><thead><tr><th>餐品</th><th>单价</th><th>数量</th><th>小计</th><th></th></tr></thead><tbody>`+
    ks.map(k=>{const m=D.menu[k],q=CART[k];return `<tr><td><b>${m.name}</b>${m.discountType?`<br><span class="fg gold">${m.discountType}</span>`:''}</td>
      <td>¥${m.currentPrice.toFixed(1)}</td>
      <td><input type="number" value="${q}" min="1" style="width:66px;padding:7px 9px;font-size:13px" onchange="CART['${k}']=+this.value;renderCart()"></td>
      <td><b>¥${(m.currentPrice*q).toFixed(1)}</b></td>
      <td><button class="chip" onclick="delete CART['${k}'];renderCart()">删</button></td></tr>`}).join('')+
    `</tbody></table></div>`:'<div class="empty" style="padding:26px"><div class="emptyi">🛒</div>购物车为空<br>去「菜单看板」加入餐品</div>';
}

function calcBest(){
  const ks=Object.keys(CART),o=document.getElementById('couponOut');
  if(!ks.length){o.innerHTML='<div class="card"><div class="note e">请先加入餐品</div></div>';return}
  const items=ks.map(k=>({m:D.menu[k],q:CART[k]}));
  const list=items.reduce((s,x)=>s+x.m.currentPrice*x.q,0);
  const orig=items.reduce((s,x)=>s+x.m.originalPrice*x.q,0);
  const promo=items.filter(x=>x.m.discountType==='促销优惠');
  const gold=items.filter(x=>x.m.discountType==='随单购麦金卡优惠');
  const bestGold=gold.length?Math.min(...gold.map(x=>x.m.currentPrice*x.q)):list;
  const pts=D.pointsProducts.filter(p=>new Date(p.downTime.replace(' ','T'))>new Date()&&p.point<=D.account.availablePoint);
  const vals=pts.map(p=>parseFloat(p.selling.match(/([\d.]+)元/)[1]));
  const bestPt=vals.length?Math.max(...vals):0;
  const bestPtP=pts.find(p=>parseFloat(p.selling.match(/([\d.]+)元/)[1])===bestPt);
  const final=Math.min(bestGold,list)-bestPt;
  o.innerHTML=`<div class="card"><div class="ct">比价结果</div>
    <div class="versus"><span style="font-size:13px;color:var(--ink3)">菜单原价</span>
      <b style="font-size:21px;color:var(--ink3);text-decoration:line-through">¥${orig.toFixed(1)}</b>
      <span class="vs">→</span><span class="vs">促销后</span><b style="font-size:21px">¥${list.toFixed(1)}</b>
      <span class="vs">→</span><span class="vs">叠加最优</span>
      <b style="font-size:26px;color:var(--mc-red)">¥${final.toFixed(1)}</b>
      <span class="pill">省 ¥${(list-final).toFixed(1)}</span></div>
    <table><thead><tr><th>阶段</th><th>金额</th><th>依据</th></tr></thead><tbody>
      <tr><td>菜单原价</td><td>¥${orig.toFixed(1)}</td><td style="font-size:12px;color:var(--ink3)">originalPrice 合计</td></tr>
      <tr><td>促销优惠后</td><td>¥${list.toFixed(1)}</td><td style="font-size:12px;color:var(--ink3)">currentPrice 合计${promo.length?`，含 ${promo.length} 项促销优惠`:''}</td></tr>
      ${gold.length?`<tr><td>麦金卡到手价</td><td>¥${bestGold.toFixed(1)}</td><td style="font-size:12px;color:var(--ink3)">随单购麦金卡优惠${bestGold<list?`，可再省 ¥${(list-bestGold).toFixed(1)}`:'（无额外优惠）'}</td></tr>`:''}
      ${bestPt?`<tr><td>积分兑换叠加</td><td>-¥${bestPt.toFixed(1)}</td><td style="font-size:12px;color:var(--ink3)">${bestPtP.spuName}（${bestPtP.point} 积分）</td></tr>`:''}
      <tr style="background:var(--ok-bg)"><td><b>最优实付</b></td><td><b style="color:var(--ok)">¥${final.toFixed(1)}</b></td>
      <td style="font-size:12px;color:var(--ok)">较原价省 ¥${(orig-final).toFixed(1)}（${((1-final/orig)*100).toFixed(0)}%）</td></tr>
    </tbody></table>
    <div class="note w"><b>重要：</b>金额为菜单 <code>currentPrice</code> 推算，<b>未调用 <code>calculate-price</code> 官方回验</b>，实际结算以官方接口为准；叠加积分需通过商城独立链路，与门店点餐结算不通。</div></div>`;
}

function addBest(){
  Object.keys(D.menu).filter(k=>D.menu[k].discountType==='随单购麦金卡优惠').slice(0,4).forEach(k=>CART[k]=(CART[k]||0)+1);
  renderCart();calcBest();
}

function advise(){
  const tp=document.getElementById('tp').value,ps=+document.getElementById('ps').value,
    md=+document.getElementById('maxd').value,mode=+document.getElementById('mode').value,
    o=document.getElementById('orderOut');
  let ss=D.stores.filter(s=>s.distance<=md).sort((a,b)=>a.distance-b.distance);
  if(!ss.length){o.innerHTML=`<div class="card"><div class="note e">${md} 米内无可用门店，请放宽距离限制</div></div>`;return}
  const tpN={walk:'步行',bike:'骑车',metro:'地铁',car:'自驾'}[tp];
  const w=tp==='car'?1.6:tp==='bike'?1.3:tp==='metro'?1.15:1;
  const eta=ss[0].distance/80*w;
  const modeN={1:'到店自取（beType=1）',5:'得来速车道取餐（beType=5）',2:'麦乐送到家（beType=2）'}[mode];
  const reasons=[];
  if(tp==='car'&&mode===5)reasons.push('自驾 + 车道取餐，全程不进店，避开堂食排队（推荐组合）');
  else if(tp==='car')reasons.push('自驾出行，但当前为堂食场景，需预留停车与进店时间');
  else if(tp==='walk')reasons.push(`步行 ${ss[0].distance} 米，按 80 米/分钟估算约 ${Math.round(eta)} 分钟`);
  else if(tp==='bike')reasons.push(`骑行 ${ss[0].distance} 米，按 ${Math.round(80/w)} 米/分钟估算约 ${Math.round(eta)} 分钟`);
  else reasons.push(`地铁换乘步行 ${ss[0].distance} 米，约 ${Math.round(eta)} 分钟`);
  reasons.push(`营业时间 ${ss[0].businessStartTime}–${ss[0].businessEndTime}，当前${ss[0].businessStatus?'营业中':'休息中'}`);
  if(ss[0].reservation)reasons.push('支持预约下单，可跳过现场点单环节，直接取餐');
  if(ps>=2)reasons.push(`${ps} 人用餐建议选${ps>=4?'四件套':'三件套'}类套餐，当前门店有 ${Object.values(D.menu).filter(m=>m.name.includes(ps>=4?'四件套':'三件套')).length} 款可选`);
  if(mode===2)reasons.push('麦乐送场景需先经 <code>delivery-query-addresses</code> 确认配送地址，再查可配送门店');
  o.innerHTML=`<div class="card"><div class="ct">推荐：${ss[0].storeName}</div>
    <div class="cd">${modeN} · ${tpN} · ${ps} 人 · storeCode ${ss[0].storeCode}</div>
    <div class="sgrid" style="margin-bottom:18px">
      <div class="stat mc"><div class="statv">${ss[0].distance}</div><div class="statl">距离（米）</div></div>
      <div class="stat mc"><div class="statv">${Math.round(eta)}</div><div class="statl">预计分钟</div></div>
      <div class="stat"><div class="statv">${ss[0].reservation?'支持':'不支持'}</div><div class="statl">预约下单</div></div>
      <div class="stat"><div class="statv">${ss[0].businessStatus?'营业中':'休息'}</div><div class="statl">当前状态</div></div>
    </div>
    <div style="font-size:13.5px;font-weight:800;margin-bottom:9px">推荐理由（仅基于可核实数据）</div>
    <ol style="padding-left:21px;font-size:13.5px;line-height:1.95;color:var(--ink2)">${reasons.map(r=>`<li>${r}</li>`).join('')}</ol>
    <div style="font-size:13.5px;font-weight:800;margin:19px 0 9px">备选门店</div>
    ${ss.slice(1,4).map(s=>`<div style="display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid var(--line)">
      <span>${s.storeName}</span><b>${s.distance} 米</b></div>`).join('')||'<div style="font-size:13px;color:var(--ink3)">范围内无其他门店</div>'}
    <div class="note e"><b>能力边界声明：</b>麦当劳 MCP Server <b>不提供门店实时客流、排队时长或繁忙度数据</b>。本推荐仅基于距离、营业状态、预约能力与取餐方式推导，不含实时路况耗时与排队预估。</div>
    <div class="note o"><b>下单前必做：</b>将最终订单金额交由 <code>calculate-price</code> 官方回验，并在用户确认后再调用 <code>create-order</code>。<code>create-order</code> 会真实下单并产生费用。</div></div>`;
}

